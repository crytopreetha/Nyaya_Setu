# --- Database ---
POSTGRES_USER=nyayasetu
POSTGRES_PASSWORD=nyayasetu_dev_password
POSTGRES_DB=nyayasetu
DATABASE_URL=postgresql+psycopg2://nyayasetu:nyayasetu_dev_password@db:5432/nyayasetu

# --- Language model (OpenAI-compatible). Leave blank to run in offline mock mode. ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_EXTRACTION=gpt-4o-mini
OPENAI_MODEL_EXPLANATION=gpt-4o-mini

# --- Auth (demo mode) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# --- Storage ---
STORAGE_DIR=/app/storage_data

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
